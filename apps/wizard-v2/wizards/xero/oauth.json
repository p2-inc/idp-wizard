{
  "schemaVersion": "1.0",
  "id": "xero-oauth",
  "providerId": "xero",
  "protocol": "oauth",
  "title": "Xero OAuth",
  "alias": {
    "prefix": "xero-oauth",
    "sessionKey": "p2_xero_oauth"
  },
  "idpConfig": {
    "providerId": "oidc",
    "hideOnLogin": true,
    "defaults": {
      "syncMode": "FORCE",
      "clientAuthMethod": "client_secret_post"
    }
  },
  "steps": [
    {
      "id": 1,
      "title": "Create a Xero App",
      "blocks": [
        {
          "type": "text",
          "content": "Open the Xero Developer Portal: https://developer.xero.com/app/manage"
        },
        {
          "type": "image",
          "src": "/wizards/xero/oauth/xero_oauth_1.png"
        },
        {
          "type": "text",
          "content": "Click \"New app\" and enter a name. Select \"Web app\" as the integration type."
        },
        {
          "type": "image",
          "src": "/wizards/xero/oauth/xero_oauth_2.png"
        },
        {
          "type": "text",
          "content": "Add the redirect URI below into the app's Redirect URI field."
        },
        {
          "type": "copy",
          "label": "Redirect URI",
          "value": "{{api.ssoUrl}}",
          "hint": "Add this as a Redirect URI in your Xero app"
        },
        {
          "type": "image",
          "src": "/wizards/xero/oauth/xero_oauth_3.png"
        }
      ]
    },
    {
      "id": 2,
      "title": "Client Credentials",
      "enableNextWhen": "state.metadataValidated",
      "blocks": [
        {
          "type": "text",
          "content": "Open the Configuration page of your Xero app. Copy the Client ID."
        },
        {
          "type": "text",
          "content": "Click \"Generate a secret\" to create the Client Secret. Xero only shows the secret once — copy it before navigating away."
        },
        {
          "type": "image",
          "src": "/wizards/xero/oauth/xero_oauth_4.png"
        },
        {
          "type": "image",
          "src": "/wizards/xero/oauth/xero_oauth_5.png"
        },
        {
          "type": "text",
          "content": "Paste both values below."
        },
        {
          "type": "formGroup",
          "id": "xeroCreds",
          "exclusive": false,
          "forms": [
            "clientCredentials"
          ]
        }
      ]
    },
    {
      "id": 3,
      "title": "Confirmation",
      "type": "confirm",
      "blocks": [
        {
          "type": "confirm",
          "title": "Create Xero Identity Provider",
          "description": "Configuration is complete. Click the button below to create the identity provider in Keycloak.",
          "buttonText": "Create Xero Identity Provider",
          "action": "createIdp",
          "adminLink": "{{api.adminLinkOidc}}",
          "adminButtonText": "Manage Xero Identity Provider"
        }
      ]
    }
  ],
  "forms": {
    "clientCredentials": {
      "title": "Xero OAuth Credentials",
      "description": "Enter the Client ID and Client Secret from your Xero app.",
      "fields": [
        {
          "id": "clientId",
          "type": "text",
          "label": "Client ID",
          "placeholder": "your-client-id",
          "required": true
        },
        {
          "id": "clientSecret",
          "type": "password",
          "label": "Client Secret",
          "placeholder": "your-client-secret",
          "required": true
        }
      ],
      "submit": {
        "label": "Verify & Save",
        "action": "validateCredentials"
      }
    }
  },
  "actions": {
    "validateCredentials": {
      "endpoint": "importConfig",
      "method": "POST",
      "contentType": "json",
      "body": {
        "fromUrl": "https://identity.xero.com/.well-known/openid-configuration",
        "providerId": "oidc"
      },
      "onSuccess": {
        "mergeIntoMetadata": "{{response}}",
        "dispatch": [
          "METADATA_VALIDATED",
          "CREDENTIALS_PROVIDED"
        ]
      },
      "messages": {
        "success": "Xero OIDC configuration verified. You can now create the identity provider.",
        "error": "Could not fetch Xero OIDC configuration. Please try again."
      }
    },
    "createIdp": {
      "endpoint": "createIdp",
      "method": "POST",
      "contentType": "json",
      "body": {
        "alias": "{{alias}}",
        "displayName": "{{alias}}",
        "providerId": "oidc",
        "hideOnLogin": true,
        "config": {
          "syncMode": "FORCE",
          "clientAuthMethod": "client_secret_post",
          "clientId": "{{state.formValues.clientId}}",
          "clientSecret": "{{state.formValues.clientSecret}}",
          "$spread": "{{state.metadata}}"
        }
      },
      "onSuccess": {
        "dispatch": [
          {
            "type": "SUBMIT_SUCCESS",
            "result": "Xero Identity Provider created successfully."
          }
        ],
        "then": [
          "clearAlias"
        ]
      },
      "messages": {
        "error": "Error creating Identity Provider. One may already be configured for this realm."
      }
    },
    "clearAlias": {
      "type": "clearAlias"
    }
  }
}
