{
  "schemaVersion": "1.0",
  "id": "vercel-marketplace-oauth",
  "providerId": "vercel-marketplace",
  "protocol": "oauth",
  "title": "Vercel Marketplace OAuth",
  "alias": {
    "prefix": "vercel-marketplace-oauth",
    "sessionKey": "p2_vercel_marketplace_oauth"
  },
  "idpConfig": {
    "providerId": "oidc",
    "hideOnLogin": true,
    "defaults": {
      "syncMode": "FORCE",
      "clientAuthMethod": "client_secret_post"
    }
  },
  "steps": [
    {
      "id": 1,
      "title": "Create a Marketplace Integration",
      "blocks": [
        {
          "type": "text",
          "content": "Vercel Marketplace integrations use the same creation flow as a regular Vercel integration — there is no separate Marketplace page. The only difference is the Visibility setting, which controls whether the integration is publicly listed."
        },
        {
          "type": "text",
          "content": "In your Vercel Dashboard sidebar, open Integrations."
        },
        {
          "type": "image",
          "src": "/wizards/vercel-marketplace/oauth/vercel_marketplace_oauth_1.png"
        },
        {
          "type": "text",
          "content": "Click \"Create Integration\"."
        },
        {
          "type": "image",
          "src": "/wizards/vercel-marketplace/oauth/vercel_marketplace_oauth_2.png"
        },
        {
          "type": "text",
          "content": "In the integration form, set Visibility to \"Public\" — this is what makes it a Marketplace integration (discoverable by all Vercel users)."
        },
        {
          "type": "image",
          "src": "/wizards/vercel-marketplace/oauth/vercel_marketplace_oauth_3.png"
        },
        {
          "type": "text",
          "content": "Paste the redirect URL below into the Redirect URL field."
        },
        {
          "type": "copy",
          "label": "Redirect URL",
          "value": "{{api.ssoUrl}}",
          "hint": "Add this as the Redirect URL in your Vercel Marketplace integration"
        },
        {
          "type": "image",
          "src": "/wizards/vercel-marketplace/oauth/vercel_marketplace_oauth_4.png"
        }
      ]
    },
    {
      "id": 2,
      "title": "Client Credentials",
      "enableNextWhen": "state.credentialsProvided",
      "blocks": [
        {
          "type": "text",
          "content": "Copy the Integration Client ID and Client Secret from the Vercel Marketplace integration settings and paste them below."
        },
        {
          "type": "formGroup",
          "id": "vercelMarketCreds",
          "exclusive": false,
          "forms": [
            "clientCredentials"
          ]
        }
      ]
    },
    {
      "id": 3,
      "title": "Confirmation",
      "type": "confirm",
      "blocks": [
        {
          "type": "confirm",
          "title": "Create Vercel Marketplace Identity Provider",
          "description": "Configuration is complete. Click the button below to create the identity provider in Keycloak.",
          "buttonText": "Create Vercel Marketplace Identity Provider",
          "action": "createIdp",
          "adminLink": "{{api.adminLinkOidc}}",
          "adminButtonText": "Manage Vercel Marketplace Identity Provider"
        }
      ]
    }
  ],
  "forms": {
    "clientCredentials": {
      "title": "Vercel Marketplace OAuth Credentials",
      "description": "Enter the Client ID and Client Secret from your Vercel Marketplace integration.",
      "fields": [
        {
          "id": "clientId",
          "type": "text",
          "label": "Client ID",
          "placeholder": "your-client-id",
          "required": true
        },
        {
          "id": "clientSecret",
          "type": "password",
          "label": "Client Secret",
          "placeholder": "your-client-secret",
          "required": true
        }
      ],
      "submit": {
        "label": "Save Credentials",
        "action": "saveCredentials"
      }
    }
  },
  "actions": {
    "saveCredentials": {
      "type": "saveForm",
      "fields": ["clientId", "clientSecret"],
      "dispatch": ["CREDENTIALS_PROVIDED"]
    },
    "createIdp": {
      "endpoint": "createIdp",
      "method": "POST",
      "contentType": "json",
      "body": {
        "alias": "{{alias}}",
        "displayName": "{{alias}}",
        "providerId": "oidc",
        "hideOnLogin": true,
        "config": {
          "syncMode": "FORCE",
          "clientAuthMethod": "client_secret_post",
          "clientId": "{{state.formValues.clientId}}",
          "clientSecret": "{{state.formValues.clientSecret}}",
          "authorizationUrl": "https://vercel.com/oauth/authorize",
          "tokenUrl": "https://api.vercel.com/v2/oauth/access_token",
          "userInfoUrl": "https://api.vercel.com/v2/user",
          "defaultScope": "read:user"
        }
      },
      "onSuccess": {
        "dispatch": [
          {
            "type": "SUBMIT_SUCCESS",
            "result": "Vercel Marketplace Identity Provider created successfully."
          }
        ],
        "then": [
          "clearAlias"
        ]
      },
      "messages": {
        "error": "Error creating Identity Provider. One may already be configured for this realm."
      }
    },
    "clearAlias": {
      "type": "clearAlias"
    }
  }
}
