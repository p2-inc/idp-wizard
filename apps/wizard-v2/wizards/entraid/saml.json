{
  "schemaVersion": "1.0",
  "id": "entraid-saml",
  "providerId": "entraid",
  "protocol": "saml",
  "title": "Microsoft Entra ID SAML",
  "alias": {
    "prefix": "entraid-saml",
    "sessionKey": "p2_entraid_saml"
  },
  "idpConfig": {
    "providerId": "saml",
    "hideOnLogin": true,
    "defaults": {
      "syncMode": "FORCE",
      "allowCreate": "true",
      "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified",
      "principalType": "SUBJECT"
    }
  },
  "steps": [
    {
      "id": 1,
      "title": "Create a SAML Application",
      "blocks": [
        {
          "type": "text",
          "content": "Select \"Enterprise applications\" from your Entra Id dashboard."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-1.png"
        },
        {
          "type": "text",
          "content": "Click \"New application\" and continue."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-2.png"
        },
        {
          "type": "text",
          "content": "Select \"Create your own application\", which will open a dialog that will allow you to enter a name."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-3a.png"
        },
        {
          "type": "text",
          "content": "Enter an App name that describes this application. Under \"What are you looking to do with your application?\", select \"Integrate any other application you dont find in the gallery (Non-gallery)\", then select \"Create\"."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-3.png"
        },
        {
          "type": "text",
          "content": "Next, select \"Single Sign On\" from the \"Manage\" section in the left sidebar navigation menu, and then \"SAML\"."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-4.png"
        }
      ]
    },
    {
      "id": 2,
      "title": "Configure SAML Metadata",
      "enableNextWhen": "state.metadataValidated",
      "blocks": [
        {
          "type": "text",
          "content": "Click the Edit icon in the top right of the first step."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-5.png"
        },
        {
          "type": "text",
          "content": "Click the \"Add identifier\" and \"Add reply URL\" links to open the fields for editing."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-5a.png"
        },
        {
          "type": "copy",
          "label": "Entity ID",
          "value": "{{api.entityId}}",
          "hint": "Sometimes called Audience URI or SP Entity ID"
        },
        {
          "type": "copy",
          "label": "Reply URL",
          "value": "{{api.ssoUrl}}",
          "hint": "Sometimes called SSO Service URL or Callback URL"
        },
        {
          "type": "text",
          "content": "Submit the identifier and the Reply URL in the Basic SAML Configuration. Click the \"Save\" button when you have pasted both values."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-6.png"
        },
        {
          "type": "text",
          "content": "Copy the App Federation Metadata URL from the SAML Signing Certificate section of your Entra application."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-1a.png"
        },
        {
          "type": "formGroup",
          "id": "metadataInput",
          "exclusive": false,
          "forms": ["metadataUrl"]
        }
      ]
    },
    {
      "id": 3,
      "title": "Configure Attribute Mapping",
      "blocks": [
        {
          "type": "text",
          "content": "To configure your identity provider to send the following SAML attributes, click the \"Edit\" icon in the top right of the second section."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-7.png"
        },
        {
          "type": "text",
          "content": "If the claims are as shown in the image, you can accept these default and move on to the next step. If not, click each Claim name in the Additional claims section to open an edit page."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-8.png"
        },
        {
          "type": "text",
          "content": "In the edit page for each claim, paste the following values in the Name, Namespace and Source Attribute."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/entraid-1.png"
        },
        {
          "type": "text",
          "content": "Copy the following Name, Namespace and Source Attribute values for each item. Paste and save each to a claim in your Entra ID application."
        },
        {
          "type": "attributeTable",
          "columns": {
            "name": "Name",
            "namespace": "Namespace",
            "value": "Source Attribute"
          },
          "rows": [
            {
              "name": "emailaddress",
              "namespace": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims",
              "value": "user.mail"
            },
            {
              "name": "givenname",
              "namespace": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims",
              "value": "user.givenname"
            },
            {
              "name": "name",
              "namespace": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims",
              "value": "user.userprincipalname"
            },
            {
              "name": "surname",
              "namespace": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims",
              "value": "user.surname"
            }
          ]
        }
      ]
    },
    {
      "id": 4,
      "title": "Assign Users and Groups",
      "blocks": [
        {
          "type": "text",
          "content": "In order for your users and groups of users to be synced to your application, you will need to assign them to your Azure AD SAML Application. Select \"Users and groups\" from the \"Manage\" section of the navigation menu."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-9.png"
        },
        {
          "type": "text",
          "content": "Select \"Add user/group\" from the top menu."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-10.png"
        },
        {
          "type": "text",
          "content": "Select \"None selected\" under the \"Users and Groups\". In the menu, select the users and groups of users that you want to add to the SAML application, and click \"Select\"."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-11.png"
        },
        {
          "type": "text",
          "content": "Select \"Assign\" to add the selected users and groups of users to your SAML application."
        },
        {
          "type": "image",
          "src": "/wizards/msft_entra_id/saml/azure-12.png"
        }
      ]
    },
    {
      "id": 5,
      "title": "Confirmation",
      "type": "confirm",
      "blocks": [
        {
          "type": "confirm",
          "title": "Create SAML Identity Provider",
          "description": "Configuration is complete. Click the button below to create the identity provider in Keycloak.",
          "buttonText": "Create SAML Identity Provider",
          "action": "createIdp",
          "adminLink": "{{api.adminLinkSaml}}",
          "adminButtonText": "Manage SAML Identity Provider"
        }
      ]
    }
  ],
  "forms": {
    "metadataUrl": {
      "title": "Metadata URL",
      "description": "Paste the SAML metadata URL provided by your identity provider.",
      "fields": [
        {
          "id": "url",
          "type": "url",
          "label": "Metadata URL",
          "placeholder": "https://login.microsoftonline.com/your-tenant-id/federationmetadata/2007-06/federationmetadata.xml",
          "required": true
        }
      ],
      "submit": {
        "label": "Validate URL",
        "action": "validateMetadataUrl"
      }
    }
  },
  "actions": {
    "validateMetadataUrl": {
      "endpoint": "importConfig",
      "method": "POST",
      "contentType": "json",
      "body": {
        "fromUrl": "{{form.url}}",
        "providerId": "saml"
      },
      "onSuccess": {
        "mergeIntoMetadata": "{{response}}",
        "dispatch": ["METADATA_VALIDATED"]
      },
      "messages": {
        "success": "Metadata URL validated. Continue to the next step.",
        "error": "Validation failed. Check the URL and try again."
      }
    },
    "createIdp": {
      "endpoint": "createIdp",
      "method": "POST",
      "contentType": "json",
      "body": {
        "alias": "{{alias}}",
        "displayName": "{{alias}}",
        "providerId": "saml",
        "hideOnLogin": true,
        "config": "{{state.metadata}}"
      },
      "onSuccess": {
        "dispatch": [
          {
            "type": "SUBMIT_SUCCESS",
            "result": "SAML Identity Provider created successfully."
          }
        ],
        "then": ["addSamlMappers", "clearAlias"]
      },
      "messages": {
        "error": "Error creating Identity Provider. One may already be configured for this realm."
      }
    },
    "addSamlMappers": {
      "endpoint": "addMappers",
      "method": "POST",
      "contentType": "json",
      "foreach": [
        {
          "attributeName": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress",
          "friendlyName": "",
          "userAttribute": "username"
        },
        {
          "attributeName": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress",
          "friendlyName": "",
          "userAttribute": "email"
        },
        {
          "attributeName": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname",
          "friendlyName": "",
          "userAttribute": "firstName"
        },
        {
          "attributeName": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname",
          "friendlyName": "",
          "userAttribute": "lastName"
        }
      ],
      "body": {
        "identityProviderAlias": "{{alias}}",
        "identityProviderMapper": "saml-user-attribute-idp-mapper",
        "name": "{{item.userAttribute}}",
        "config": {
          "syncMode": "INHERIT",
          "attributes": "[]",
          "attribute.name": "{{item.attributeName}}",
          "attribute.friendly.name": "{{item.friendlyName}}",
          "user.attribute": "{{item.userAttribute}}"
        }
      }
    },
    "clearAlias": {
      "type": "clearAlias"
    }
  }
}
