{
  "schemaVersion": "1.0",
  "id": "github-oauth",
  "providerId": "github",
  "protocol": "oauth",
  "title": "GitHub OAuth",
  "alias": {
    "prefix": "github-oauth",
    "sessionKey": "p2_github_oauth"
  },
  "idpConfig": {
    "providerId": "github",
    "hideOnLogin": true,
    "defaults": {
      "syncMode": "FORCE"
    }
  },
  "steps": [
    {
      "id": 1,
      "title": "Create an OAuth App",
      "blocks": [
        {
          "type": "text",
          "content": "In GitHub, go to Settings → Developer settings → OAuth Apps and click 'New OAuth App'. Give it a name and set the Homepage URL. Then use the redirect URI below as the Authorization callback URL."
        },
        {
          "type": "copy",
          "label": "Authorization callback URL",
          "value": "{{api.ssoUrl}}",
          "hint": "Paste this as the Authorization callback URL in GitHub"
        }
      ]
    },
    {
      "id": 2,
      "title": "Client Credentials",
      "enableNextWhen": "state.credentialsProvided",
      "blocks": [
        {
          "type": "text",
          "content": "After creating the OAuth App, copy the Client ID and generate a new Client Secret. Paste both values below."
        },
        {
          "type": "formGroup",
          "id": "githubCreds",
          "exclusive": false,
          "forms": [
            "clientCredentials"
          ]
        }
      ]
    },
    {
      "id": 3,
      "title": "Confirmation",
      "type": "confirm",
      "blocks": [
        {
          "type": "confirm",
          "title": "Create GitHub Identity Provider",
          "description": "Configuration is complete. Click the button below to create the identity provider in Keycloak.",
          "buttonText": "Create GitHub Identity Provider",
          "action": "createIdp",
          "adminLink": "{{api.adminLinkSocial}}",
          "adminButtonText": "Manage GitHub Identity Provider"
        }
      ]
    }
  ],
  "forms": {
    "clientCredentials": {
      "title": "GitHub OAuth Credentials",
      "description": "Enter the Client ID and Client Secret from your GitHub OAuth App.",
      "fields": [
        {
          "id": "clientId",
          "type": "text",
          "label": "Client ID",
          "placeholder": "your-client-id",
          "required": true
        },
        {
          "id": "clientSecret",
          "type": "password",
          "label": "Client Secret",
          "placeholder": "your-client-secret",
          "required": true
        }
      ],
      "submit": {
        "label": "Save Credentials",
        "action": "saveCredentials"
      }
    }
  },
  "actions": {
    "saveCredentials": {
      "type": "saveForm",
      "fields": ["clientId", "clientSecret"],
      "dispatch": ["CREDENTIALS_PROVIDED"]
    },
    "createIdp": {
      "endpoint": "createIdp",
      "method": "POST",
      "contentType": "json",
      "body": {
        "alias": "{{alias}}",
        "displayName": "{{alias}}",
        "providerId": "github",
        "hideOnLogin": true,
        "config": {
          "syncMode": "FORCE",
          "clientId": "{{state.formValues.clientId}}",
          "clientSecret": "{{state.formValues.clientSecret}}"
        }
      },
      "onSuccess": {
        "dispatch": [
          {
            "type": "SUBMIT_SUCCESS",
            "result": "GitHub Identity Provider created successfully."
          }
        ],
        "then": [
          "clearAlias"
        ]
      },
      "messages": {
        "error": "Error creating Identity Provider. One may already be configured for this realm."
      }
    },
    "clearAlias": {
      "type": "clearAlias"
    }
  }
}
