{
  "schemaVersion": "1.0",
  "id": "google-oauth",
  "providerId": "google",
  "protocol": "oauth",
  "title": "Google OAuth",
  "alias": {
    "prefix": "google-oauth",
    "sessionKey": "p2_google_oauth"
  },
  "idpConfig": {
    "providerId": "google",
    "hideOnLogin": true,
    "defaults": {
      "syncMode": "FORCE"
    }
  },
  "steps": [
    {
      "id": 1,
      "title": "Create OAuth Credentials",
      "blocks": [
        {
          "type": "text",
          "content": "In the Google Cloud Console, go to APIs & Services → Credentials and create a new OAuth 2.0 Client ID. Select Web application as the application type. Add the following URL to the Authorized redirect URIs."
        },
        {
          "type": "copy",
          "label": "Authorized redirect URI",
          "value": "{{api.ssoUrl}}",
          "hint": "Add this to the Authorized redirect URIs in Google Cloud Console"
        }
      ]
    },
    {
      "id": 2,
      "title": "Client Credentials",
      "enableNextWhen": "state.credentialsProvided",
      "blocks": [
        {
          "type": "text",
          "content": "Copy the Client ID and Client Secret from your Google OAuth credentials and paste them below."
        },
        {
          "type": "formGroup",
          "id": "googleCreds",
          "exclusive": false,
          "forms": [
            "clientCredentials"
          ]
        }
      ]
    },
    {
      "id": 3,
      "title": "Confirmation",
      "type": "confirm",
      "blocks": [
        {
          "type": "confirm",
          "title": "Create Google Identity Provider",
          "description": "Configuration is complete. Click the button below to create the identity provider in Keycloak.",
          "buttonText": "Create Google Identity Provider",
          "action": "createIdp",
          "adminLink": "{{api.adminLinkSocial}}",
          "adminButtonText": "Manage Google Identity Provider"
        }
      ]
    }
  ],
  "forms": {
    "clientCredentials": {
      "title": "Google OAuth Credentials",
      "description": "Enter the Client ID and Client Secret from Google Cloud Console.",
      "fields": [
        {
          "id": "clientId",
          "type": "text",
          "label": "Client ID",
          "placeholder": "your-client-id.apps.googleusercontent.com",
          "required": true
        },
        {
          "id": "clientSecret",
          "type": "password",
          "label": "Client Secret",
          "placeholder": "your-client-secret",
          "required": true
        }
      ],
      "submit": {
        "label": "Save Credentials",
        "action": "saveCredentials"
      }
    }
  },
  "actions": {
    "saveCredentials": {
      "type": "saveForm",
      "fields": ["clientId", "clientSecret"],
      "dispatch": ["CREDENTIALS_PROVIDED"]
    },
    "createIdp": {
      "endpoint": "createIdp",
      "method": "POST",
      "contentType": "json",
      "body": {
        "alias": "{{alias}}",
        "displayName": "{{alias}}",
        "providerId": "google",
        "hideOnLogin": true,
        "config": {
          "syncMode": "FORCE",
          "clientId": "{{state.formValues.clientId}}",
          "clientSecret": "{{state.formValues.clientSecret}}"
        }
      },
      "onSuccess": {
        "dispatch": [
          {
            "type": "SUBMIT_SUCCESS",
            "result": "Google Identity Provider created successfully."
          }
        ],
        "then": [
          "clearAlias"
        ]
      },
      "messages": {
        "error": "Error creating Identity Provider. One may already be configured for this realm."
      }
    },
    "clearAlias": {
      "type": "clearAlias"
    }
  }
}
