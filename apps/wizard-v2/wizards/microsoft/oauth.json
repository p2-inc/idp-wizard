{
  "schemaVersion": "1.0",
  "id": "microsoft-oauth",
  "providerId": "microsoft",
  "protocol": "oauth",
  "title": "Microsoft OAuth",
  "alias": {
    "prefix": "microsoft-oauth",
    "sessionKey": "p2_microsoft_oauth"
  },
  "idpConfig": {
    "providerId": "microsoft",
    "hideOnLogin": true,
    "defaults": {
      "syncMode": "FORCE"
    }
  },
  "steps": [
    {
      "id": 1,
      "title": "Register an Application",
      "blocks": [
        {
          "type": "text",
          "content": "In the Microsoft Entra admin center, go to App registrations and create a new registration. Select 'Accounts in any organizational directory and personal Microsoft accounts' for broad access. Add the redirect URI below under Authentication → Platform configurations → Web."
        },
        {
          "type": "copy",
          "label": "Redirect URI",
          "value": "{{api.ssoUrl}}",
          "hint": "Add this as a Web redirect URI in the Authentication section"
        }
      ]
    },
    {
      "id": 2,
      "title": "Client Credentials",
      "enableNextWhen": "state.credentialsProvided",
      "blocks": [
        {
          "type": "text",
          "content": "Note the Application (client) ID from the Overview page. Then go to Certificates & secrets, create a new client secret, and paste both values below."
        },
        {
          "type": "formGroup",
          "id": "microsoftCreds",
          "exclusive": false,
          "forms": [
            "clientCredentials"
          ]
        }
      ]
    },
    {
      "id": 3,
      "title": "Confirmation",
      "type": "confirm",
      "blocks": [
        {
          "type": "confirm",
          "title": "Create Microsoft Identity Provider",
          "description": "Configuration is complete. Click the button below to create the identity provider in Keycloak.",
          "buttonText": "Create Microsoft Identity Provider",
          "action": "createIdp",
          "adminLink": "{{api.adminLinkSocial}}",
          "adminButtonText": "Manage Microsoft Identity Provider"
        }
      ]
    }
  ],
  "forms": {
    "clientCredentials": {
      "title": "Microsoft OAuth Credentials",
      "description": "Enter the Application ID and Client Secret from your Microsoft app registration.",
      "fields": [
        {
          "id": "clientId",
          "type": "text",
          "label": "Application (Client) ID",
          "placeholder": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
          "required": true
        },
        {
          "id": "clientSecret",
          "type": "password",
          "label": "Client Secret Value",
          "placeholder": "your-client-secret-value",
          "required": true
        }
      ],
      "submit": {
        "label": "Save Credentials",
        "action": "saveCredentials"
      }
    }
  },
  "actions": {
    "saveCredentials": {
      "type": "saveForm",
      "fields": ["clientId", "clientSecret"],
      "dispatch": ["CREDENTIALS_PROVIDED"]
    },
    "createIdp": {
      "endpoint": "createIdp",
      "method": "POST",
      "contentType": "json",
      "body": {
        "alias": "{{alias}}",
        "displayName": "{{alias}}",
        "providerId": "microsoft",
        "hideOnLogin": true,
        "config": {
          "syncMode": "FORCE",
          "clientId": "{{state.formValues.clientId}}",
          "clientSecret": "{{state.formValues.clientSecret}}"
        }
      },
      "onSuccess": {
        "dispatch": [
          {
            "type": "SUBMIT_SUCCESS",
            "result": "Microsoft Identity Provider created successfully."
          }
        ],
        "then": [
          "clearAlias"
        ]
      },
      "messages": {
        "error": "Error creating Identity Provider. One may already be configured for this realm."
      }
    },
    "clearAlias": {
      "type": "clearAlias"
    }
  }
}
