{
  "schemaVersion": "1.0",
  "id": "generic-oidc-idp-initiated",
  "providerId": "openid",
  "protocol": "oidc-idp-initiated",
  "title": "Generic OIDC (IdP-initiated)",
  "alias": {
    "prefix": "openid-oidc-idp-initiated",
    "sessionKey": "p2_openid_oidc-idp-initiated"
  },
  "idpConfig": {
    "providerId": "oidc",
    "hideOnLogin": true,
    "defaults": {
      "syncMode": "FORCE",
      "clientAuthMethod": "client_secret_post"
    }
  },
  "steps": [
    {
      "id": 1,
      "title": "Create an OpenID Connect Application",
      "blocks": [
        {
          "type": "text",
          "content": "In your identity provider, create an OpenID Connect application. Set its redirect URI to the value below, and set its app tile or initiate-login URI to the Initiate Login URL. When a user launches the app from their identity provider, the Initiate Login URL starts a normal OpenID Connect sign-in at Keycloak and then sends the user to your application."
        },
        {
          "type": "copy",
          "label": "Redirect URI",
          "value": "{{api.ssoUrl}}",
          "hint": "Sometimes called Callback URL or Login Redirect URI"
        },
        {
          "type": "copy",
          "label": "Initiate Login URL",
          "value": "{{api.idpInitiatedLoginUrl}}",
          "hint": "Okta: Initiate login URI (choose \"Redirect to app to initiate login\"). Entra ID: the app's Home page URL / Sign-on URL. Other identity providers: the URL the app tile opens."
        },
        {
          "type": "text",
          "content": "Requirements: the realm's browser flow (or the flow override on the login client) must include the Identity Provider Redirector step, which the default browser flow does. A user who already has a Keycloak session is signed in without visiting the identity provider again."
        }
      ]
    },
    {
      "id": 2,
      "title": "Configure Identity Provider",
      "enableNextWhen": "state.metadataValidated",
      "blocks": [
        {
          "type": "text",
          "content": "Provide the OpenID Connect configuration for your identity provider. Use the discovery URL if available — it's the easiest option."
        },
        {
          "type": "formGroup",
          "id": "oidcConfigInput",
          "exclusive": true,
          "forms": [
            "configUrl",
            "configManual"
          ]
        }
      ]
    },
    {
      "id": 3,
      "title": "Client Credentials",
      "enableNextWhen": "state.credentialsProvided",
      "blocks": [
        {
          "type": "text",
          "content": "Enter the client ID and secret generated by your identity provider when you created the application."
        },
        {
          "type": "formGroup",
          "id": "clientCredentials",
          "exclusive": false,
          "forms": [
            "clientCredentials"
          ]
        }
      ]
    },
    {
      "id": 4,
      "title": "Choose the Target Application",
      "enableNextWhen": "state.targetAppConfigured",
      "blocks": [
        {
          "type": "text",
          "content": "Enter the home page of the application users land in after signing in. The application must use OpenID Connect against this realm: it receives the user without a token, starts its own sign-in, and completes it from the Keycloak session the user now has. Keycloak appends a SAMLResponse parameter to the home page URL, which the application should ignore. SAML applications are not supported with an OpenID Connect identity provider."
        },
        {
          "type": "formGroup",
          "id": "targetApp",
          "exclusive": true,
          "forms": [
            "targetOidc"
          ]
        }
      ]
    },
    {
      "id": 5,
      "title": "Configure User Access",
      "blocks": [
        {
          "type": "text",
          "content": "Assign the users or groups who should be able to launch the application from your identity provider, then continue."
        }
      ]
    },
    {
      "id": 6,
      "title": "Confirmation",
      "type": "confirm",
      "blocks": [
        {
          "type": "confirm",
          "title": "Set Up IdP-Initiated OIDC Login",
          "description": "Configuration is complete. This creates the login client and the OpenID Connect identity provider in Keycloak.",
          "buttonText": "Create IdP-Initiated Login",
          "action": "createClient",
          "adminLink": "{{api.adminLinkOidc}}",
          "adminButtonText": "Manage OIDC Identity Provider"
        }
      ]
    }
  ],
  "forms": {
    "configUrl": {
      "title": "Discovery URL",
      "description": "Paste the OpenID Connect discovery URL (/.well-known/openid-configuration) from your identity provider.",
      "fields": [
        {
          "id": "url",
          "type": "url",
          "label": "Discovery URL",
          "placeholder": "https://your-idp.example.com/.well-known/openid-configuration",
          "required": true
        }
      ],
      "submit": {
        "label": "Fetch Configuration",
        "action": "validateConfigUrl"
      }
    },
    "configManual": {
      "title": "Manual Configuration",
      "description": "Enter the authorization, token, and optional userinfo endpoint URLs directly.",
      "fields": [
        {
          "id": "authorizationUrl",
          "type": "url",
          "label": "Authorization URL",
          "placeholder": "https://your-idp.example.com/oauth/authorize",
          "required": true
        },
        {
          "id": "tokenUrl",
          "type": "url",
          "label": "Token URL",
          "placeholder": "https://your-idp.example.com/oauth/token",
          "required": true
        },
        {
          "id": "userInfoUrl",
          "type": "url",
          "label": "UserInfo URL",
          "placeholder": "https://your-idp.example.com/oauth/userinfo",
          "required": false
        },
        {
          "id": "issuer",
          "type": "text",
          "label": "Issuer",
          "placeholder": "https://your-idp.example.com",
          "required": false
        }
      ],
      "submit": {
        "label": "Save Configuration",
        "action": "validateConfigManual"
      }
    },
    "clientCredentials": {
      "title": "Client Credentials",
      "description": "Enter the client ID and client secret from your identity provider.",
      "fields": [
        {
          "id": "clientId",
          "type": "text",
          "label": "Client ID",
          "placeholder": "your-client-id",
          "required": true
        },
        {
          "id": "clientSecret",
          "type": "password",
          "label": "Client Secret",
          "placeholder": "your-client-secret",
          "required": true
        }
      ],
      "submit": {
        "label": "Save Credentials",
        "action": "saveClientCredentials"
      }
    },
    "targetOidc": {
      "title": "OIDC application",
      "description": "After login, users are sent to the application's home page, where the application signs them in with OpenID Connect using the Keycloak session they now have.",
      "fields": [
        {
          "id": "appHomeUrl",
          "type": "url",
          "label": "Application home page",
          "placeholder": "https://app.example.com/",
          "required": true
        }
      ],
      "submit": {
        "label": "Save",
        "action": "saveTargetOidc"
      }
    }
  },
  "actions": {
    "validateConfigUrl": {
      "endpoint": "importConfig",
      "method": "POST",
      "contentType": "json",
      "body": {
        "fromUrl": "{{form.url}}",
        "providerId": "oidc"
      },
      "onSuccess": {
        "mergeIntoMetadata": "{{response}}",
        "dispatch": [
          "METADATA_VALIDATED"
        ]
      },
      "messages": {
        "success": "Configuration fetched. Continue to set your client credentials.",
        "error": "Could not fetch configuration. Check the discovery URL and try again."
      }
    },
    "validateConfigManual": {
      "endpoint": "importConfig",
      "method": "POST",
      "contentType": "json",
      "body": {
        "authorizationUrl": "{{form.authorizationUrl}}",
        "tokenUrl": "{{form.tokenUrl}}",
        "userInfoUrl": "{{form.userInfoUrl}}",
        "issuer": "{{form.issuer}}",
        "providerId": "oidc"
      },
      "onSuccess": {
        "mergeIntoMetadata": "{{response}}",
        "dispatch": [
          "METADATA_VALIDATED"
        ]
      },
      "messages": {
        "success": "Configuration saved. Continue to set your client credentials.",
        "error": "Could not validate the configuration. Check the URLs and try again."
      }
    },
    "saveClientCredentials": {
      "type": "saveForm",
      "dispatch": [
        "CREDENTIALS_PROVIDED"
      ],
      "fields": [
        "clientId",
        "clientSecret"
      ]
    },
    "saveTargetOidc": {
      "type": "saveForm",
      "dispatch": [
        "TARGET_APP_CONFIGURED"
      ],
      "fields": [
        "appHomeUrl"
      ],
      "set": {
        "targetRedirectUrl": "{{form.appHomeUrl}}",
        "targetPostUrl": "",
        "targetForcePost": "false"
      }
    },
    "createClient": {
      "endpoint": "createClient",
      "method": "POST",
      "contentType": "json",
      "allowStatuses": [
        409
      ],
      "body": {
        "protocol": "saml",
        "clientId": "{{idpInitiatedClientId}}",
        "name": "",
        "description": "Generated by the IdP wizard for identity provider {{alias}}",
        "attributes": {
          "saml_idp_initiated_sso_url_name": "{{idpInitiatedClientId}}",
          "saml_idp_initiated_sso_relay_state": "",
          "saml.force.post.binding": "{{state.formValues.targetForcePost}}",
          "saml_assertion_consumer_url_redirect": "{{state.formValues.targetRedirectUrl}}",
          "saml_assertion_consumer_url_post": "{{state.formValues.targetPostUrl}}",
          "phasetwo.idp-initiated.alias": "{{alias}}"
        }
      },
      "onSuccess": {
        "then": [
          "createIdp"
        ]
      },
      "messages": {
        "error": "Error creating the IdP-initiated login client."
      }
    },
    "createIdp": {
      "endpoint": "createIdp",
      "method": "POST",
      "contentType": "json",
      "body": {
        "alias": "{{alias}}",
        "displayName": "{{displayName}}",
        "providerId": "oidc",
        "hideOnLogin": true,
        "config": {
          "$spread": "{{state.metadata}}",
          "syncMode": "FORCE",
          "clientAuthMethod": "client_secret_post",
          "clientId": "{{state.formValues.clientId}}",
          "clientSecret": "{{state.formValues.clientSecret}}"
        }
      },
      "onSuccess": {
        "dispatch": [
          {
            "type": "SUBMIT_SUCCESS",
            "result": "IdP-initiated OIDC login is configured. Users can now launch the application from their identity provider."
          }
        ],
        "then": [
          "clearAlias"
        ]
      },
      "messages": {
        "error": "Error creating Identity Provider. One may already be configured for this realm."
      }
    },
    "clearAlias": {
      "type": "clearAlias"
    }
  }
}
