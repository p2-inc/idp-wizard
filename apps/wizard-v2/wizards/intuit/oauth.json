{
  "schemaVersion": "1.0",
  "id": "intuit-oauth",
  "providerId": "intuit",
  "protocol": "oauth",
  "title": "Intuit OAuth",
  "alias": {
    "prefix": "intuit-oauth",
    "sessionKey": "p2_intuit_oauth"
  },
  "idpConfig": {
    "providerId": "oidc",
    "hideOnLogin": true,
    "defaults": {
      "syncMode": "FORCE",
      "clientAuthMethod": "client_secret_post"
    }
  },
  "steps": [
    {
      "id": 1,
      "title": "Create an Intuit App",
      "blocks": [
        {
          "type": "text",
          "content": "In the Intuit Developer Portal, create a new app and select the Sign in with Intuit scope. Use the redirect URI below in the app's Keys & credentials settings."
        },
        {
          "type": "copy",
          "label": "Redirect URI",
          "value": "{{api.ssoUrl}}",
          "hint": "Add this as a Redirect URI in the Intuit Developer Portal"
        }
      ]
    },
    {
      "id": 2,
      "title": "Client Credentials",
      "enableNextWhen": "state.metadataValidated",
      "blocks": [
        {
          "type": "text",
          "content": "Copy the Client ID and Client Secret from your Intuit app's Keys & credentials page and paste them below."
        },
        {
          "type": "formGroup",
          "id": "intuitCreds",
          "exclusive": false,
          "forms": [
            "clientCredentials"
          ]
        }
      ]
    },
    {
      "id": 3,
      "title": "Confirmation",
      "type": "confirm",
      "blocks": [
        {
          "type": "confirm",
          "title": "Create Intuit Identity Provider",
          "description": "Configuration is complete. Click the button below to create the identity provider in Keycloak.",
          "buttonText": "Create Intuit Identity Provider",
          "action": "createIdp",
          "adminLink": "{{api.adminLinkOidc}}",
          "adminButtonText": "Manage Intuit Identity Provider"
        }
      ]
    }
  ],
  "forms": {
    "clientCredentials": {
      "title": "Intuit OAuth Credentials",
      "description": "Enter the Client ID and Client Secret from your Intuit app.",
      "fields": [
        {
          "id": "clientId",
          "type": "text",
          "label": "Client ID",
          "placeholder": "your-client-id",
          "required": true
        },
        {
          "id": "clientSecret",
          "type": "password",
          "label": "Client Secret",
          "placeholder": "your-client-secret",
          "required": true
        }
      ],
      "submit": {
        "label": "Verify & Save",
        "action": "validateCredentials"
      }
    }
  },
  "actions": {
    "validateCredentials": {
      "endpoint": "importConfig",
      "method": "POST",
      "contentType": "json",
      "body": {
        "fromUrl": "https://developer.api.intuit.com/.well-known/openid_configuration",
        "providerId": "oidc"
      },
      "onSuccess": {
        "mergeIntoMetadata": "{{response}}",
        "dispatch": [
          "METADATA_VALIDATED",
          "CREDENTIALS_PROVIDED"
        ]
      },
      "messages": {
        "success": "Intuit OIDC configuration verified. You can now create the identity provider.",
        "error": "Could not fetch Intuit OIDC configuration. Please try again."
      }
    },
    "createIdp": {
      "endpoint": "createIdp",
      "method": "POST",
      "contentType": "json",
      "body": {
        "alias": "{{alias}}",
        "displayName": "{{alias}}",
        "providerId": "oidc",
        "hideOnLogin": true,
        "config": {
          "syncMode": "FORCE",
          "clientAuthMethod": "client_secret_post",
          "clientId": "{{state.formValues.clientId}}",
          "clientSecret": "{{state.formValues.clientSecret}}",
          "$spread": "{{state.metadata}}"
        }
      },
      "onSuccess": {
        "dispatch": [
          {
            "type": "SUBMIT_SUCCESS",
            "result": "Intuit Identity Provider created successfully."
          }
        ],
        "then": [
          "clearAlias"
        ]
      },
      "messages": {
        "error": "Error creating Identity Provider. One may already be configured for this realm."
      }
    },
    "clearAlias": {
      "type": "clearAlias"
    }
  }
}
