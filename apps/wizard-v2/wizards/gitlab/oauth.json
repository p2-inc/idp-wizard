{
  "schemaVersion": "1.0",
  "id": "gitlab-oauth",
  "providerId": "gitlab",
  "protocol": "oauth",
  "title": "GitLab OAuth",
  "alias": {
    "prefix": "gitlab-oauth",
    "sessionKey": "p2_gitlab_oauth"
  },
  "idpConfig": {
    "providerId": "gitlab",
    "hideOnLogin": true,
    "defaults": {
      "syncMode": "FORCE"
    }
  },
  "steps": [
    {
      "id": 1,
      "title": "Create a GitLab Application",
      "blocks": [
        {
          "type": "text",
          "content": "Open your GitLab OAuth applications page: https://gitlab.com/oauth/applications (for self-hosted instances, use Admin Area → Applications instead)."
        },
        {
          "type": "text",
          "content": "Create a new application with the 'openid', 'profile', and 'email' scopes. Use the redirect URI below."
        },
        {
          "type": "copy",
          "label": "Redirect URI",
          "value": "{{api.ssoUrl}}",
          "hint": "Paste this as the Redirect URI in GitLab"
        }
      ]
    },
    {
      "id": 2,
      "title": "Client Credentials",
      "enableNextWhen": "state.credentialsProvided",
      "blocks": [
        {
          "type": "text",
          "content": "After saving the application, copy the Application ID and Secret and paste them below."
        },
        {
          "type": "formGroup",
          "id": "gitlabCreds",
          "exclusive": false,
          "forms": [
            "clientCredentials"
          ]
        }
      ]
    },
    {
      "id": 3,
      "title": "Confirmation",
      "type": "confirm",
      "blocks": [
        {
          "type": "confirm",
          "title": "Create GitLab Identity Provider",
          "description": "Configuration is complete. Click the button below to create the identity provider in Keycloak.",
          "buttonText": "Create GitLab Identity Provider",
          "action": "createIdp",
          "adminLink": "{{api.adminLinkSocial}}",
          "adminButtonText": "Manage GitLab Identity Provider"
        }
      ]
    }
  ],
  "forms": {
    "clientCredentials": {
      "title": "GitLab OAuth Credentials",
      "description": "Enter the Application ID and Secret from your GitLab application.",
      "fields": [
        {
          "id": "clientId",
          "type": "text",
          "label": "Application ID",
          "placeholder": "your-application-id",
          "required": true
        },
        {
          "id": "clientSecret",
          "type": "password",
          "label": "Secret",
          "placeholder": "your-secret",
          "required": true
        }
      ],
      "submit": {
        "label": "Save Credentials",
        "action": "saveCredentials"
      }
    }
  },
  "actions": {
    "saveCredentials": {
      "type": "saveForm",
      "fields": ["clientId", "clientSecret"],
      "dispatch": ["CREDENTIALS_PROVIDED"]
    },
    "createIdp": {
      "endpoint": "createIdp",
      "method": "POST",
      "contentType": "json",
      "body": {
        "alias": "{{alias}}",
        "displayName": "{{alias}}",
        "providerId": "gitlab",
        "hideOnLogin": true,
        "config": {
          "syncMode": "FORCE",
          "clientId": "{{state.formValues.clientId}}",
          "clientSecret": "{{state.formValues.clientSecret}}"
        }
      },
      "onSuccess": {
        "dispatch": [
          {
            "type": "SUBMIT_SUCCESS",
            "result": "GitLab Identity Provider created successfully."
          }
        ],
        "then": [
          "clearAlias"
        ]
      },
      "messages": {
        "error": "Error creating Identity Provider. One may already be configured for this realm."
      }
    },
    "clearAlias": {
      "type": "clearAlias"
    }
  }
}
