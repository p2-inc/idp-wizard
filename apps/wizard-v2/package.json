{
  "name": "wizard-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "optimize:screenshots": "./scripts/optimize-screenshots.sh",
    "preview": "vite preview",
    "gen-api": "tsx openapi-codegen/gen.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:integration": "PLAYWRIGHT_INTEGRATION=true playwright test",
    "test:integration:ui": "PLAYWRIGHT_INTEGRATION=true playwright test --ui",
    "test:external": "PLAYWRIGHT_INTEGRATION=true playwright test e2e/external-providers/",
    "capture:aws:saml": "tsx wizards/aws/playwright/saml-capture.ts",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d && until curl -sf http://localhost:8080/auth/realms/wizard > /dev/null; do sleep 2; done && open http://localhost:8080/auth/admin/master/console/#/wizard",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:restart": "docker compose -f docker/docker-compose.yml restart",
    "docker:reset": "docker compose -f docker/docker-compose.yml down -v"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.72.0",
    "oidc-spa": "^10.2.18",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tanstack/router-devtools": "^1.167.3",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
