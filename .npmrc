# wizard-v1 (React 17) pulls @types/react@16 in transitively via @types/enzyme. pnpm hoists
# transitive dependencies into the shared hidden store, where lucide-react — which ships no
# React types of its own — resolved it instead of wizard-v2's @types/react@19. Two React type
# identities in one program makes every lucide icon fail to typecheck (TS2786). Keeping
# @types/react out of the hoist lets each app resolve its own copy.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
